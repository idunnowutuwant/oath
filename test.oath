struct PacketHeader {
    magic: [0, 65535],
    len: [14, 1500],
    checksum: [0, 255]
}

fn sanitize_payload(pkt: [0, 255; len], len: [14, 1500], idx: [0, 1499], val: [0, 255]) -> [0, 255]
    requires idx < len
{
    pkt[idx] = val;
    return pkt[idx];
}

fn alloc_scratch(sz: [1, 1024]) -> resource {
    let h = alloc(sz);
    return h;
}

fn free_scratch(h: resource) -> [0, 0] {
    free(h);
    return 0;
}

fn process_incoming_packet(raw_len: tainted, pkt: [0, 255; 1500]) -> [0, 255] {
    let h = alloc_scratch(256);
    free_scratch(h);

    if raw_len >= 14 && raw_len <= 1500 {
        return sanitize_payload(pkt, raw_len, 0, 42);
    } else {
        return 0;
    }
}

fn v2_benchmark_core() -> [0, 1500] {
    let budget = 1500;
    let step = 0;
    while (step < 8) {
        budget = budget - 10;
        step = step + 1;
    }
    return budget;
}
