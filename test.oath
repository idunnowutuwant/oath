struct PacketHeader {
    magic: [0, 65535],
    len: [14, 1500],
    checksum: [0, 255]
}

enum NetStatus {
    Accepted: [0, 1500],
    Dropped: [0, 0]
}

fn validate_header(hdr: PacketHeader) -> [0, 1500] {
    if hdr.magic == 21850 && hdr.checksum != 0 {
        return hdr.len;
    } else {
        return 0;
    }
}

fn sanitize_payload(pkt: [0, 255; len], len: [14, 1500], idx: [0, 1499], val: [0, 255]) -> [0, 255]
    requires idx < len
{
    pkt[idx] = val;
    return pkt[idx];
}

fn dma_forward(rx: [0, 255; 8], tx: [0, 255; 8])
    requires disjoint(rx, tx)
    -> [0, 255]
{
    let i = 0;
    while (i < 8) {
        tx[i] = rx[i];
        i = i + 1;
    }
    return tx[0];
}

fn net_pipeline_benchmark() -> [0, 1500] {
    let budget = 1500;
    let step = 0;
    while (step < 8) {
        budget = budget - 10;
        step = step + 1;
    }
    return budget;
}